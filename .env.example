# ExamGenius AI settings. setup.bat copies this file to .env - then fill in ONE key below.
# NEVER share or commit .env

# ---- Choose the AI provider: openai | gemini | github  (leave blank = use whichever key is filled) ----
AI_PROVIDER=

# Option A - Google Gemini (FREE tier). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B - ChatGPT models FREE via GitHub Models. Token from https://github.com/settings/personal-access-tokens
#            (fine-grained token, permission "Models: Read-only")
GITHUB_TOKEN=

# Option C - OpenAI ChatGPT API (paid, needs credit). Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the model names (defaults: gemini-flash-latest / openai/gpt-4o-mini / gpt-4o-mini)
# Run  python manage.py check_ai  to test your key and list the models it can use.
AI_CHAT_MODEL=
AI_EMBED_MODEL=

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
AI_RATE_LIMIT=120/hour
